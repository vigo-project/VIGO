<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- .NET 10 LTS fallback: switch to net10.0 and remove runtime-async (see docs/DECISIONS.md ADR-001). -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Features>$(Features);runtime-async=on</Features>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Company>VIGO</Company>
    <Product>VIGO</Product>
    <Version>0.1.0-beta.1</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Production libraries: verified trimming/AOT-compatible. -->
  <PropertyGroup Condition="'$(IsVigoLibrary)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
