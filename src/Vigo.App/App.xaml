<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Vigo.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>


            <!-- Interface font and text sizes. Declared here, at the top level of the application resources, and not in
                 Styles.xaml: a style of Styles.xaml reads them with ThemeResource and would find its own copy first, so the
                 values UiText.Apply writes at launch (user's font and text size) would never be seen. Every FontSize /
                 LineHeight of the XAML is {ThemeResource VigoFontSizeN / VigoLineHeightN} (icons excepted); a new size needs
                 its key here and in Services/UiText.cs. -->
            <FontFamily x:Key="VigoFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="VigoDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <x:Double x:Key="VigoFontSize7">7</x:Double>
            <x:Double x:Key="VigoFontSize8">8</x:Double>
            <x:Double x:Key="VigoFontSize9">9</x:Double>
            <x:Double x:Key="VigoFontSize10">10</x:Double>
            <x:Double x:Key="VigoFontSize11">11</x:Double>
            <x:Double x:Key="VigoFontSize12">12</x:Double>
            <x:Double x:Key="VigoFontSize13">13</x:Double>
            <x:Double x:Key="VigoFontSize14">14</x:Double>
            <x:Double x:Key="VigoFontSize15">15</x:Double>
            <x:Double x:Key="VigoFontSize16">16</x:Double>
            <x:Double x:Key="VigoFontSize20">20</x:Double>
            <x:Double x:Key="VigoFontSize22">22</x:Double>
            <x:Double x:Key="VigoFontSize24">24</x:Double>
            <x:Double x:Key="VigoFontSize28">28</x:Double>
            <x:Double x:Key="VigoLineHeight13">13</x:Double>
            <x:Double x:Key="VigoLineHeight14">14</x:Double>
            <x:Double x:Key="VigoLineHeight16">16</x:Double>
            <x:Double x:Key="VigoLineHeight18">18</x:Double>
            <x:Double x:Key="VigoLineHeight20">20</x:Double>
            <x:Double x:Key="VigoLineHeight21">21</x:Double>
            <x:Double x:Key="VigoLineHeight22">22</x:Double>
            <x:Double x:Key="VigoLineHeight28">28</x:Double>
            <x:Double x:Key="VigoLineHeight36">36</x:Double>

            <!-- The VIGO accent is fixed (independent of the user's Windows accent), as in the mockups. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#FF60CDFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF60CDFF</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF60CDFF</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF99EBFF</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF60CDFF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF57B9E6" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF4EA6CF" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF60CDFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF0B0B0C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#FF005FB8</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF005FB8</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF003E92</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF001A68</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF005FB8" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF1975C5" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF3183CA" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF005FB8" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
