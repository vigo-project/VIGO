<?xml version="1.0" encoding="utf-8"?>
<!-- Right panel of a repository tab: selected commit (mockup VIGO.dc.html, showCommit section). -->
<UserControl
    x:Class="Vigo.App.Views.CommitDetailsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vigo.App.Controls"
    xmlns:views="using:Vigo.App.Views"
    xmlns:services="using:Vigo.App.Services"
    xmlns:vm="using:Vigo.Core.ViewModels">

    <UserControl.Resources>
        <!-- File row: change icon, name (+ its folder in path mode), +/− bars; indented in tree mode. -->
        <DataTemplate x:Key="FileRowTemplate" x:DataType="vm:ChangedFileItem">
            <Button Style="{StaticResource VigoSubtleButton}" Height="{x:Bind services:Appearance.Current.RowHeight, Mode=OneWay}"
                    Padding="{x:Bind views:CommitDetailsPanel.RowPadding(Indent), Mode=OneWay}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Tag="{x:Bind}" Click="OnFileClick" ToolTipService.ToolTip="{x:Bind Tooltip}"
                    AutomationProperties.Name="{x:Bind File.Path}">
                <Button.ContextFlyout>
                    <MenuFlyout Opening="OnRowMenuOpening">
                        <MenuFlyoutItem Tag="{x:Bind}" Click="OnApplyFilesClick" Visibility="Collapsed">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind controls:FluentIcons.ArchiveArrowBack}" FontFamily="{StaticResource VigoIconFont}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="CdRowHistory" Tag="{x:Bind}" Click="OnHistoryClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind controls:FluentIcons.History}" FontFamily="{StaticResource VigoIconFont}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="CdRowBlame" Tag="{x:Bind}" Click="OnBlameClick" IsEnabled="{x:Bind CanBlame}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind controls:FluentIcons.Person}" FontFamily="{StaticResource VigoIconFont}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.ContextFlyout>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Stash only: the selected files (Ctrl / Maj click) are applied alone from the row menu (J7.16). -->
                    <Border Grid.ColumnSpan="4" Margin="-6,0" CornerRadius="4" IsHitTestVisible="False" Background="{ThemeResource VigoAccentSoftBrush}"
                            Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                    <controls:StatusBadge Grid.Column="1" Letter="{x:Bind StatusLetter}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{ThemeResource VigoFontSize13}">
                        <Run Text="{x:Bind Name}" />
                        <Run Text="{x:Bind DirectoryLabel, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" />
                    </TextBlock>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Border Width="{x:Bind AdditionsBarWidth}" Height="6" CornerRadius="1" Background="{ThemeResource VigoAddTextBrush}" />
                        <Border Width="{x:Bind DeletionsBarWidth}" Height="6" CornerRadius="1" Background="{ThemeResource VigoDelTextBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Folder row of the tree: a click collapses or expands it. -->
        <DataTemplate x:Key="FolderRowTemplate" x:DataType="vm:FolderRow">
            <Button Style="{StaticResource VigoSubtleButton}" Height="{x:Bind services:Appearance.Current.RowHeight, Mode=OneWay}"
                    Padding="{x:Bind views:CommitDetailsPanel.RowPadding(Indent)}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Tag="{x:Bind}" Click="OnFolderClick" ToolTipService.ToolTip="{x:Bind Path}"
                    AutomationProperties.Name="{x:Bind Path}">
                <controls:FolderRowContent Folder="{x:Bind}" />
            </Button>
        </DataTemplate>

        <controls:FileRowTemplateSelector x:Key="FileRowSelector"
                                          FileTemplate="{StaticResource FileRowTemplate}"
                                          FolderTemplate="{StaticResource FolderRowTemplate}" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource VigoLayerBrush}">
        <!-- No selection: the working directory panel comes in J3. -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" Padding="24"
                    Visibility="{x:Bind views:CommitDetailsPanel.Collapsed(ViewModel.HasSelection), Mode=OneWay}">
            <TextBlock x:Uid="CdNoSelection" Style="{StaticResource VigoStrongText}" HorizontalAlignment="Center" />
            <TextBlock x:Uid="CdNoSelectionHint" Style="{StaticResource VigoCaptionText}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: short SHA, copy, close. -->
            <Grid Padding="14,0,8,0" ColumnSpacing="8" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="CdTitle" Style="{StaticResource VigoCaptionText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ShortSha, Mode=OneWay}" FontFamily="{StaticResource VigoMonoFont}"
                           FontSize="{ThemeResource VigoFontSize12}" FontWeight="SemiBold" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                <Button x:Uid="CdCopySha" Grid.Column="2" Style="{StaticResource VigoSubtleButton}" Width="24" Height="24" Click="OnCopyShaClick">
                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText2Brush}"
                              Glyph="{x:Bind controls:FluentIcons.Copy}" />
                </Button>
                <Button x:Uid="CdClose" Grid.Column="4" Style="{StaticResource VigoSubtleButton}" Width="28" Height="28" Command="{x:Bind ViewModel.CloseCommand}">
                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Glyph="{x:Bind controls:FluentIcons.Dismiss}" />
                </Button>
            </Grid>

            <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32" />
            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource VigoSecondaryText}"
                       TextWrapping="Wrap" Margin="14" Visibility="{x:Bind views:CommitDetailsPanel.VisibleIf(ViewModel.ErrorMessage), Mode=OneWay}" />

            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"
                          Visibility="{x:Bind views:CommitDetailsPanel.VisibleIf(ViewModel.Details), Mode=OneWay}">
                <StackPanel Padding="14" Spacing="14">
                    <!-- Message -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontFamily="{ThemeResource VigoDisplayFont}" FontSize="{ThemeResource VigoFontSize15}"
                                   LineHeight="{ThemeResource VigoLineHeight21}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <!--
                            Description: scrolls beyond its height, which the grip below changes (shared by every tab,
                            remembered); more room for the description, or for the changed files.
                        -->
                        <Grid Visibility="{x:Bind ViewModel.HasBody, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="BodyScroller" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"
                                          MaxHeight="140">
                                <TextBlock Text="{x:Bind ViewModel.Body, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" LineHeight="{ThemeResource VigoLineHeight18}" TextWrapping="Wrap"
                                           Padding="0,0,12,0" Foreground="{ThemeResource VigoText2Brush}" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                            <controls:Splitter x:Name="MessageSplitter" x:Uid="CdSplitter" Grid.Row="1" Orientation="Horizontal" Height="12">
                                <Border Height="1" VerticalAlignment="Center" Background="{ThemeResource VigoStrokeSubtleBrush}" />
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="6,0" Background="{ThemeResource VigoLayerBrush}">
                                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText3Brush}"
                                              Glyph="{x:Bind controls:FluentIcons.ReOrderDotsHorizontal}" />
                                </Border>
                            </controls:Splitter>
                        </Grid>
                    </StackPanel>

                    <!-- Ref badges -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Badges}">
                        <ItemsRepeater.Layout>
                            <LinedFlowLayout MinItemSpacing="6" LineSpacing="6" LineHeight="{ThemeResource VigoLineHeight18}" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommitBadge">
                                <Border Height="18" Padding="6,0" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{x:Bind controls:LaneBrushes.For(ColorIndex)}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind views:CommitDetailsPanel.BadgeIcon(Kind)}" />
                                        <TextBlock Text="{x:Bind Label}" FontSize="{ThemeResource VigoFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Author card -->
                    <Border Style="{StaticResource VigoCard}" Padding="12">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="32" Height="32" CornerRadius="16"
                                        Background="{x:Bind controls:LaneBrushes.For(ViewModel.AuthorColorIndex), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.AuthorInitials, Mode=OneWay}" Foreground="White" FontSize="{ThemeResource VigoFontSize12}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.AuthorName, Mode=OneWay}" Style="{StaticResource VigoStrongText}" />
                                    <TextBlock Text="{x:Bind ViewModel.AuthorEmail, Mode=OneWay}" Style="{StaticResource VigoCaptionText}" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </StackPanel>
                            <Grid ColumnSpacing="8" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="CdCreated" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AuthoredDisplay, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" TextWrapping="Wrap" />
                                <TextBlock x:Uid="CdCommitter" Grid.Row="1" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CommitterDisplay, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" TextWrapping="Wrap" />
                                <TextBlock x:Uid="CdParents" Grid.Row="2" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" />
                                <ItemsRepeater Grid.Row="2" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Parents}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ParentLink">
                                            <HyperlinkButton x:Uid="CdParentLink" Padding="0" MinHeight="0" FontFamily="{StaticResource VigoMonoFont}" FontSize="{ThemeResource VigoFontSize12}"
                                                             Content="{x:Bind ShortSha}"
                                                             Tag="{x:Bind}" Click="OnParentClick" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock x:Uid="CdSignature" Grid.Row="3" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}"
                                           Visibility="{x:Bind ViewModel.IsSigned, Mode=OneWay}" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Visibility="{x:Bind ViewModel.IsSigned, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.SignatureTooltip, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.SignatureDisplay, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource VigoSuccessBrush}" Visibility="{x:Bind ViewModel.IsSignatureGood, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.SignatureDisplay, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource VigoDangerBrush}" Visibility="{x:Bind ViewModel.IsSignatureBad, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.SignatureDisplay, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource VigoWarningBrush}" Visibility="{x:Bind ViewModel.IsSignatureDoubtful, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Changed files: as paths, or as a tree of folders (Path / Tree switch) -->
                    <StackPanel>
                        <Grid Height="28" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.FilesSummary, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.AdditionsDisplay, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoAddTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DeletionsDisplay, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoDelTextBrush}" />
                            </StackPanel>
                            <controls:FileListModeSwitch x:Name="FilesModeSwitch" Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                        <controls:FolderToggleBar Rows="{x:Bind ViewModel.FileRows}" ToggleRequested="OnToggleFolders" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FileRows}" ItemTemplate="{StaticResource FileRowSelector}" Margin="-6,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
