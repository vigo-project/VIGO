<?xml version="1.0" encoding="utf-8"?>
<!-- "Start" screen (mockup VIGO.dc.html, isWelcome section). -->
<UserControl
    x:Class="Vigo.App.Views.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vigo.App.Controls"
    xmlns:views="using:Vigo.App.Views"
    xmlns:vm="using:Vigo.Core.ViewModels">

    <!--
        Centered by a full-width Grid, not by the ScrollViewer: the ScrollViewer placed a centered page differently
        depending on whether it was taller than the viewport, so filtering the recent list moved it sideways.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid MaxWidth="1160" Padding="40,40,40,64" ColumnSpacing="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- Main column -->
                <StackPanel Spacing="32">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="WelcomeTitle" Style="{StaticResource VigoTitleText}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock x:Uid="WelcomeSubtitle" Style="{StaticResource VigoSecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Uid="WelcomeOpenButton" Grid.Column="0" Style="{StaticResource VigoActionTile}" Command="{x:Bind ViewModel.OpenCommand}">
                            <controls:ActionTileContent x:Uid="WelcomeOpenTile" Icon="folder_open" />
                        </Button>
                        <Button x:Uid="WelcomeCloneButton" Grid.Column="1" Style="{StaticResource VigoActionTile}" Command="{x:Bind ViewModel.CloneCommand}">
                            <controls:ActionTileContent x:Uid="WelcomeCloneTile" Icon="cloud_arrow_down" />
                        </Button>
                        <Button x:Uid="WelcomeInitButton" Grid.Column="2" Style="{StaticResource VigoActionTile}" Command="{x:Bind ViewModel.InitCommand}">
                            <controls:ActionTileContent x:Uid="WelcomeInitTile" Icon="folder_add" />
                        </Button>
                    </Grid>

                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock x:Uid="WelcomeRecentTitle" Style="{StaticResource VigoSubtitleText}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                            <TextBox
                                x:Uid="WelcomeFilter"
                                Width="260"
                                HorizontalAlignment="Right"
                                Style="{StaticResource VigoSearchBox}"
                                Text="{x:Bind ViewModel.RecentFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Border Style="{StaticResource VigoCard}" Padding="0">
                            <Grid>
                                <!-- 52px rows: badge, name + monospace path, branch, date, pin. Separator above every row but the first. -->
                                <!-- Every row has a top separator, as in the mockup; the first one is hidden under the card border. -->
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recents}" Margin="0,-1,0,0">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RecentRepositoryItem">
                                            <Grid Height="52" BorderThickness="0,1,0,0"
                                                  BorderBrush="{ThemeResource VigoStrokeSubtleBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="40" />
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource VigoSubtleButton}" CornerRadius="0" Padding="16,0,0,0"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Tag="{x:Bind}" Click="OnRecentClick"
                                                        AutomationProperties.Name="{x:Bind Name}"
                                                        ToolTipService.ToolTip="{x:Bind Path}">
                                                    <Button.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="{x:Bind views:WelcomeView.PinLabel(IsPinned)}" Tag="{x:Bind}" Click="OnTogglePinClick">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Style="{StaticResource VigoIcon}" Glyph="{x:Bind controls:FluentIcons.FromName('pin')}" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem x:Uid="WelcomeRemoveRecent" Tag="{x:Bind}" Click="OnRemoveRecentClick">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Style="{StaticResource VigoIcon}" Glyph="{x:Bind controls:FluentIcons.FromName('dismiss')}" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.ContextFlyout>
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="110" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="28" Height="28" CornerRadius="{StaticResource VigoRadiusTile}"
                                                                Background="{x:Bind views:WelcomeView.LaneBrush(ColorIndex)}">
                                                            <TextBlock Text="{x:Bind Initials}" Foreground="White" FontSize="{ThemeResource VigoFontSize12}" FontWeight="SemiBold"
                                                                       FontFamily="{ThemeResource VigoDisplayFont}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource VigoStrongText}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource VigoMonoCaptionText}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText2Brush}"
                                                                      Glyph="{x:Bind controls:FluentIcons.FromName('branch')}" />
                                                            <TextBlock Text="{x:Bind Branch}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{x:Bind LastOpenedDisplay}" FontSize="{ThemeResource VigoFontSize12}" VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource VigoText3Brush}" />
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1" Style="{StaticResource VigoSubtleButton}" Width="28" Height="28"
                                                        HorizontalAlignment="Left" Tag="{x:Bind}" Click="OnTogglePinClick"
                                                        AutomationProperties.Name="{x:Bind views:WelcomeView.PinLabel(IsPinned)}"
                                                        ToolTipService.ToolTip="{x:Bind views:WelcomeView.PinLabel(IsPinned)}">
                                                    <Grid>
                                                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Visibility="{x:Bind IsPinned}"
                                                                  Foreground="{ThemeResource VigoAccentTextBrush}" Glyph="{x:Bind controls:FluentIcons.FromName('pin')}" />
                                                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Visibility="{x:Bind views:WelcomeView.Collapsed(IsPinned)}"
                                                                  Foreground="{ThemeResource VigoStrokeStrongBrush}" Glyph="{x:Bind controls:FluentIcons.FromName('pin')}" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" Padding="16,32"
                                            Visibility="{x:Bind ViewModel.HasNoRecents, Mode=OneWay}">
                                    <TextBlock x:Uid="WelcomeNoRecentTitle" Style="{StaticResource VigoStrongText}" HorizontalAlignment="Center" />
                                    <TextBlock x:Uid="WelcomeNoRecentText" Style="{StaticResource VigoCaptionText}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Uid="WelcomeNoMatch" Style="{StaticResource VigoCaptionText}" Padding="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.HasNoMatch, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Side column -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource VigoCard}" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="WelcomeHostsTitle" Style="{StaticResource VigoCardTitleText}" Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level2" />
                            <controls:HostRow Initials="GH" HostName="GitHub" Color="#FF24292F" Status="{x:Bind ViewModel.GitHubStatus, Mode=OneWay}"
                                      ActionText="{x:Bind ViewModel.GitHubActionText, Mode=OneWay}" ActionCommand="{x:Bind ViewModel.OpenIntegrationsCommand}" />
                            <controls:HostRow Initials="GL" HostName="GitLab" Color="#FFC6471B" />
                            <controls:HostRow Initials="AZ" HostName="Azure DevOps" Color="#FF0A63B8" Status="{x:Bind ViewModel.AzureDevOpsStatus, Mode=OneWay}"
                                      ActionText="{x:Bind ViewModel.AzureDevOpsActionText, Mode=OneWay}" ActionCommand="{x:Bind ViewModel.OpenIntegrationsCommand}" />
                            <controls:HostRow Initials="BB" HostName="Bitbucket" Color="#FF0B52CC" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource VigoCard}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="WelcomeProfileTitle" Style="{StaticResource VigoCardTitleText}" AutomationProperties.HeadingLevel="Level2" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource VigoLane5Brush}">
                                    <TextBlock Text="{x:Bind views:WelcomeView.IdentityInitials(ViewModel.Identity), Mode=OneWay}" Foreground="White" FontSize="{ThemeResource VigoFontSize12}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind views:WelcomeView.IdentityName(ViewModel.Identity), Mode=OneWay}" Style="{StaticResource VigoStrongText}" />
                                    <TextBlock Text="{x:Bind views:WelcomeView.IdentityEmail(ViewModel.Identity), Mode=OneWay}" Style="{StaticResource VigoCaptionText}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <HyperlinkButton x:Uid="WelcomeSwitchProfile" Padding="0" FontSize="{ThemeResource VigoFontSize12}" FontWeight="SemiBold" Click="OnSwitchProfileClick"
                                                 Visibility="{x:Bind ViewModel.CanSwitchProfile, Mode=OneWay}" />
                                <HyperlinkButton x:Uid="WelcomeManageProfiles" Padding="0" FontSize="{ThemeResource VigoFontSize12}" FontWeight="SemiBold" Command="{x:Bind ViewModel.OpenProfilesCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
