<?xml version="1.0" encoding="utf-8"?>
<!--
    Command palette (Ctrl+P, mockup VIGO.dc.html): dimmed window, card at the top with the search box, results grouped
    (Commandes, Branches, Fichiers modifiés, Commits), keyboard help at the bottom. ↑ / ↓ move, Enter runs, Échap or
    a click outside closes. Texts: x:Uid (Palette* in the .resw resources).
-->
<UserControl
    x:Class="Vigo.App.Views.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vigo.App.Controls"
    xmlns:vm="using:Vigo.Core.ViewModels">

    <Grid>
        <!-- Click outside the card: closes -->
        <Border Background="#1F000000" Tapped="OnDimmerTapped" AutomationProperties.AccessibilityView="Raw" />

        <Border Width="640" Margin="0,56,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{ThemeResource VigoFlyoutBrush}" BorderBrush="{ThemeResource VigoStrokeBrush}" BorderThickness="1" CornerRadius="8"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="12,8" ColumnSpacing="8" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource VigoIcon}" Foreground="{ThemeResource VigoText2Brush}" Glyph="{x:Bind controls:FluentIcons.Search}" />
                    <TextBox x:Name="QueryBox" x:Uid="PaletteQuery" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="{ThemeResource VigoFontSize14}"
                             TextChanged="OnQueryChanged" PreviewKeyDown="OnQueryKeyDown" />
                    <Border Grid.Column="2" Style="{StaticResource VigoKbdBorder}">
                        <TextBlock x:Uid="PaletteEscKey" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" />
                    </Border>
                </Grid>

                <ListView x:Name="Results" x:Uid="PaletteResults" Grid.Row="1" MaxHeight="400" Padding="0,4" SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="OnItemClick" SelectionChanged="OnSelectionChanged" IsTabStop="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="4,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteItem">
                            <StackPanel>
                                <TextBlock Text="{x:Bind GroupTitle}" Visibility="{x:Bind HasGroupTitle}" Margin="10,8,0,2"
                                           Style="{StaticResource VigoLabelText}" FontWeight="SemiBold" />
                                <Grid Height="32" Padding="10,0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource VigoIcon}" Foreground="{ThemeResource VigoText2Brush}"
                                              Glyph="{x:Bind controls:FluentIcons.FromName(Entry.IconName)}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{ThemeResource VigoFontSize13}">
                                        <Run Text="{x:Bind Entry.Label}" />
                                        <Run Text="{x:Bind Entry.Detail}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" />
                                    </TextBlock>
                                    <Border Grid.Column="2" Style="{StaticResource VigoKbdBorder}" Visibility="{x:Bind HasShortcut}">
                                        <TextBlock Text="{x:Bind Entry.Shortcut}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="NoResult" Grid.Row="1" Margin="16,14" Style="{StaticResource VigoSecondaryText}" Visibility="Collapsed" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Padding="14,6"
                            BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,1,0,0">
                    <TextBlock x:Uid="PaletteHintNav" Style="{StaticResource VigoCaptionText}" />
                    <TextBlock x:Uid="PaletteHintRun" Style="{StaticResource VigoCaptionText}" />
                    <TextBlock x:Uid="PaletteHintScopes" Style="{StaticResource VigoCaptionText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
