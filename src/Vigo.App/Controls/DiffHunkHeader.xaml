<?xml version="1.0" encoding="utf-8"?>
<!--
    Header of a hunk in the native unified diff (ADR-090): the "@@ … @@" line and, for a staging diff, the buttons that
    stage / unstage or discard the hunk. Shown in a view zone of the editor above the hunk, and as the sticky copy at the
    top once that zone is scrolled away.
-->
<UserControl
    x:Class="Vigo.App.Controls.DiffHunkHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="30">

    <Grid Padding="12,0,8,0" ColumnSpacing="6" Background="{ThemeResource VigoLayer2Brush}"
          BorderBrush="{ThemeResource VigoStrokeBrush}" BorderThickness="0,1,0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HeaderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                   FontFamily="{StaticResource VigoMonoFont}" FontSize="{ThemeResource VigoFontSize12}"
                   Foreground="{ThemeResource VigoText2Brush}" />
        <Button x:Name="ApplyButton" Grid.Column="1" Height="22" MinHeight="0" Padding="8,0" VerticalAlignment="Center"
                FontSize="{ThemeResource VigoFontSize12}" Visibility="Collapsed" Click="OnApplyClick" />
        <Button x:Name="DiscardButton" Grid.Column="2" Height="22" MinHeight="0" Padding="8,0" VerticalAlignment="Center"
                FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoDangerBrush}" Visibility="Collapsed"
                Click="OnDiscardClick" />
    </Grid>
</UserControl>
