<?xml version="1.0" encoding="utf-8"?>
<!-- Hosting provider row of the welcome screen: GitHub opens Préférences › Intégrations (J6.1); the others come later. -->
<UserControl
    x:Class="Vigo.App.Controls.HostRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vigo.App.Controls"
    AutomationProperties.Name="{x:Bind HostName}">
    <Grid MinHeight="48" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center">
            <Border.Background>
                <SolidColorBrush Color="{x:Bind Color}" />
            </Border.Background>
            <TextBlock Text="{x:Bind Initials}" FontSize="{ThemeResource VigoFontSize10}" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind HostName}" Style="{StaticResource VigoStrongText}" />
            <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource VigoCaptionText}" />
        </StackPanel>
        <Button Grid.Column="2" Content="{x:Bind ActionText, Mode=OneWay}" Style="{StaticResource VigoAccentButton}"
                Command="{x:Bind ActionCommand, Mode=OneWay}" IsEnabled="{x:Bind local:HostRow.HasAction(ActionCommand), Mode=OneWay}"
                VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind local:HostRow.ToolTipOf(ActionCommand, ActionToolTip), Mode=OneWay}" />
    </Grid>
</UserControl>
