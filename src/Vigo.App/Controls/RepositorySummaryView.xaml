<?xml version="1.0" encoding="utf-8"?>
<!--
    "Résumé" page of the left panel (J7.13, ADR-080), shown in place of the graph and of the right panel: header (name, branch,
    remote, totals), cards of the five latest branches, tags and commits, then the README. A click on a row goes back to the
    graph on that commit. Échap goes back to the graph. Texts: x:Uid (ADR-075); relative dates come from the view model.
-->
<UserControl
    x:Class="Vigo.App.Controls.RepositorySummaryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vigo.App.Controls"
    xmlns:vm="using:Vigo.Core.ViewModels"
    x:Uid="SummaryView">

    <UserControl.Resources>
        <!-- A row of a card: the whole row is a button (keyboard and screen readers), its DataContext is the row. -->
        <Style x:Key="SummaryRowButton" TargetType="Button" BasedOn="{StaticResource VigoSubtleButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <DataTemplate x:Key="BranchTemplate" x:DataType="vm:SummaryBranchRow">
            <Button Style="{StaticResource SummaryRowButton}" Click="OnRowClick" AutomationProperties.Name="{x:Bind Name}">
                <Grid RowSpacing="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource VigoStrongText}" FontSize="{ThemeResource VigoFontSize13}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{x:Bind TrackText}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}"
                               Visibility="{x:Bind HasTrack}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind Subject}" />
                    </TextBlock>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind Author}" /><Run Text=" · " /><Run Text="{x:Bind DateText}" />
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TagTemplate" x:DataType="vm:SummaryTagRow">
            <Button Style="{StaticResource SummaryRowButton}" Click="OnRowClick" AutomationProperties.Name="{x:Bind Name}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource VigoStrongText}" FontSize="{ThemeResource VigoFontSize13}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind DateText}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind ShortSha}" FontFamily="Cascadia Mono, Consolas" FontSize="{ThemeResource VigoFontSize11}"
                               Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="CommitTemplate" x:DataType="vm:SummaryCommitRow">
            <Button Style="{StaticResource SummaryRowButton}" Click="OnRowClick" AutomationProperties.Name="{x:Bind Subject}">
                <Grid ColumnSpacing="8" RowSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Subject}" FontSize="{ThemeResource VigoFontSize13}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ShortSha}" FontFamily="Cascadia Mono, Consolas" FontSize="{ThemeResource VigoFontSize11}"
                               Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind Author}" /><Run Text=" · " /><Run Text="{x:Bind DateText}" />
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged" Background="{ThemeResource VigoSunkenBrush}">
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Column" Padding="24,16" Spacing="12" HorizontalAlignment="Left">

                <!-- Header. -->
                <Border Style="{StaticResource VigoCard}" Padding="16">
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Uid="SummaryBack" Style="{StaticResource VigoSubtleButton}" Height="28" Padding="6,0" Click="OnCloseClick">
                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText2Brush}"
                                          Glyph="{x:Bind controls:FluentIcons.ChevronLeft}" />
                            </Button>
                            <TextBlock Text="{x:Bind ViewModel.RepositoryName, Mode=OneWay}" Style="{StaticResource VigoStrongText}" FontSize="{ThemeResource VigoFontSize20}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Uid="SummaryRefresh" Style="{StaticResource VigoSubtleButton}" Height="28" Padding="8,0" Command="{x:Bind ViewModel.RefreshCommand}">
                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Glyph="{x:Bind controls:FluentIcons.ArrowSync}" />
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="38,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasBranch, Mode=OneWay}">
                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText2Brush}"
                                          Glyph="{x:Bind controls:FluentIcons.Branch}" />
                                <TextBlock Text="{x:Bind ViewModel.BranchName, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize13}" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <HyperlinkButton Padding="0" Command="{x:Bind ViewModel.OpenRemoteCommand}" Visibility="{x:Bind ViewModel.HasRemote, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.RemoteUrl, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize13}" TextTrimming="CharacterEllipsis" />
                            </HyperlinkButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="32" Margin="38,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CommitCountText, Mode=OneWay}" Style="{StaticResource VigoStrongText}" FontSize="{ThemeResource VigoFontSize22}" />
                                <TextBlock x:Uid="SummaryCommits" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.BranchCountText, Mode=OneWay}" Style="{StaticResource VigoStrongText}" FontSize="{ThemeResource VigoFontSize22}" />
                                <TextBlock x:Uid="SummaryBranches" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.TagCountText, Mode=OneWay}" Style="{StaticResource VigoStrongText}" FontSize="{ThemeResource VigoFontSize22}" />
                                <TextBlock x:Uid="SummaryTags" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource VigoDangerBrush}"
                           Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" />

                <!-- Branches, tags, commits: three columns, one when the page is narrow (OnRootSizeChanged). -->
                <Grid x:Name="Cards" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CardColumn0" Width="*" />
                        <ColumnDefinition x:Name="CardColumn1" Width="*" />
                        <ColumnDefinition x:Name="CardColumn2" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="BranchesCard" Style="{StaticResource VigoCard}" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="SummaryBranchesTitle" Style="{StaticResource VigoStrongText}" Margin="8,4,8,2" />
                            <TextBlock x:Uid="SummaryNoBranches" Style="{StaticResource VigoSecondaryText}" FontSize="{ThemeResource VigoFontSize12}" Margin="8,2"
                                       Visibility="{x:Bind controls:RepositorySummaryView.Inverse(ViewModel.HasBranchRows), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Branches}" ItemTemplate="{StaticResource BranchTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TagsCard" Grid.Column="1" Style="{StaticResource VigoCard}" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="SummaryTagsTitle" Style="{StaticResource VigoStrongText}" Margin="8,4,8,2" />
                            <TextBlock x:Uid="SummaryNoTags" Style="{StaticResource VigoSecondaryText}" FontSize="{ThemeResource VigoFontSize12}" Margin="8,2"
                                       Visibility="{x:Bind controls:RepositorySummaryView.Inverse(ViewModel.HasTagRows), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Tags}" ItemTemplate="{StaticResource TagTemplate}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="CommitsCard" Grid.Column="2" Style="{StaticResource VigoCard}" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="SummaryCommitsTitle" Style="{StaticResource VigoStrongText}" Margin="8,4,8,2" />
                            <TextBlock x:Uid="SummaryNoCommits" Style="{StaticResource VigoSecondaryText}" FontSize="{ThemeResource VigoFontSize12}" Margin="8,2"
                                       Visibility="{x:Bind controls:RepositorySummaryView.Inverse(ViewModel.HasCommitRows), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Commits}" ItemTemplate="{StaticResource CommitTemplate}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- README. -->
                <Border Style="{StaticResource VigoCard}" Padding="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText2Brush}"
                                      Glyph="{x:Bind controls:FluentIcons.Book}" />
                            <TextBlock Text="{x:Bind ViewModel.ReadmeName, Mode=OneWay}" Style="{StaticResource VigoStrongText}" Visibility="{x:Bind ViewModel.HasReadme, Mode=OneWay}" />
                            <TextBlock x:Uid="SummaryReadmeTitle" Style="{StaticResource VigoStrongText}" Visibility="{x:Bind ViewModel.NoReadme, Mode=OneWay}" />
                        </StackPanel>
                        <InfoBar x:Uid="SummaryReadmeTruncated" IsOpen="{x:Bind ViewModel.IsReadmeTruncated, Mode=OneWay}" IsClosable="False" Severity="Informational" />
                        <controls:MarkdownView Blocks="{x:Bind ViewModel.Readme, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasReadme, Mode=OneWay}" />
                        <TextBlock x:Uid="SummaryNoReadme" Style="{StaticResource VigoSecondaryText}" FontSize="{ThemeResource VigoFontSize12}" Visibility="{x:Bind ViewModel.NoReadme, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
