<?xml version="1.0" encoding="utf-8"?>
<!--
    Comparison of two branches A and B through their merge base, shown in place of the graph: one list of files grouped by
    category (conflict, merges, ahead on one side, only on one side, identical) with a filter by category and by text.
    A click on a file opens its A → B diff in the code editor. The colour of a category is one of five badges shown by flags
    of the row (a theme brush cannot be picked from code under AOT).
-->
<UserControl
    x:Class="Vigo.App.Controls.BranchCompareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vigo.App.Controls"
    xmlns:vm="using:Vigo.Core.ViewModels"
    x:Uid="CompareRoot">

    <UserControl.Resources>
        <Style x:Key="CompareRowContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Selector of one side: the branch list of the toolbar, picking sets the side. -->
        <DataTemplate x:Key="PickerItemTemplate" x:DataType="vm:BranchPickerItem">
            <StackPanel>
                <TextBlock Text="{x:Bind GroupTitle}" Style="{StaticResource VigoLabelText}" Margin="0,6,0,4" Visibility="{x:Bind HasGroupTitle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" VerticalAlignment="Center"
                              Glyph="{x:Bind controls:FluentIcons.FromName(Icon)}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource VigoStrongText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Style="{StaticResource VigoLabelText}" VerticalAlignment="Center"
                               Visibility="{x:Bind HasDetail}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="PickerItemContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource VigoSunkenBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: back to the graph, title, summary. -->
        <Grid Padding="8,0,12,0" ColumnSpacing="10" Background="{ThemeResource VigoLayerBrush}"
              BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="CompareBackButton" Style="{StaticResource VigoSubtleButton}" Height="28" Padding="8,0" Click="OnCloseClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText2Brush}"
                              Glyph="{x:Bind controls:FluentIcons.ChevronLeft}" />
                    <TextBlock x:Uid="CompareBackText" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" />
                </StackPanel>
            </Button>
            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="6" Background="{ThemeResource VigoAccentSoftBrush}">
                <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Foreground="{ThemeResource VigoAccentTextBrush}"
                          Glyph="{x:Bind controls:FluentIcons.ArrowSwap}" />
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Uid="CompareTitle" Style="{StaticResource VigoStrongText}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize11}" LineHeight="{ThemeResource VigoLineHeight14}"
                           Foreground="{ThemeResource VigoText3Brush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="3" x:Uid="CompareRefreshButton" Style="{StaticResource VigoSubtleButton}" Height="28" Padding="8,0"
                    Command="{x:Bind ViewModel.RefreshCommand}">
                <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Glyph="{x:Bind controls:FluentIcons.ArrowSync}" />
            </Button>
        </Grid>

        <!-- Sides, category filters and text filter. -->
        <StackPanel Grid.Row="1" Padding="12,10,12,8" Spacing="8" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SideAButton" x:Uid="CompareSideA" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Uid="CompareLetterA" Style="{StaticResource VigoLabelText}" VerticalAlignment="Center" />
                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoLane5Brush}" Glyph="{x:Bind controls:FluentIcons.Branch}" />
                        <TextBlock Text="{x:Bind controls:BranchCompareView.Shown(ViewModel.NameA), Mode=OneWay}" Style="{StaticResource VigoStrongText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="SideAFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnSideAOpening">
                            <StackPanel Width="360" Spacing="6">
                                <TextBox Style="{StaticResource VigoSearchBox}" x:Uid="RepoBranchFilter"
                                         Text="{x:Bind ViewModel.PickerA.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ListView ItemsSource="{x:Bind ViewModel.PickerA.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSideAItemClick"
                                          MaxHeight="340" x:Uid="RepoBranchList" ItemContainerStyle="{StaticResource PickerItemContainer}"
                                          ItemTemplate="{StaticResource PickerItemTemplate}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="1" x:Uid="CompareSwapButton" Style="{StaticResource VigoSubtleButton}" Command="{x:Bind ViewModel.SwapCommand}">
                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Glyph="{x:Bind controls:FluentIcons.ArrowSwap}" />
                </Button>
                <Button Grid.Column="2" x:Name="SideBButton" x:Uid="CompareSideB" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Uid="CompareLetterB" Style="{StaticResource VigoLabelText}" VerticalAlignment="Center" />
                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoLane1Brush}" Glyph="{x:Bind controls:FluentIcons.Branch}" />
                        <TextBlock Text="{x:Bind controls:BranchCompareView.Shown(ViewModel.NameB), Mode=OneWay}" Style="{StaticResource VigoStrongText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="SideBFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnSideBOpening">
                            <StackPanel Width="360" Spacing="6">
                                <TextBox Style="{StaticResource VigoSearchBox}" x:Uid="RepoBranchFilter"
                                         Text="{x:Bind ViewModel.PickerB.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ListView ItemsSource="{x:Bind ViewModel.PickerB.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSideBItemClick"
                                          MaxHeight="340" x:Uid="RepoBranchList" ItemContainerStyle="{StaticResource PickerItemContainer}"
                                          ItemTemplate="{StaticResource PickerItemTemplate}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Short filter chips in a wrapping grid: equal-width tiles, label on the left and the count on the right. -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Chips}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="210" MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:BranchCompareChip">
                        <ToggleButton IsChecked="{x:Bind IsSelected, Mode=OneWay}" Height="30" Padding="10,0" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch" Click="OnChipClick">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Count}" FontSize="{ThemeResource VigoFontSize12}" Opacity="0.65" VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBox Style="{StaticResource VigoSearchBox}" x:Uid="CompareFilter"
                     Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock x:Uid="CompareConflictsUnknown" Style="{StaticResource VigoLabelText}" TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.ConflictsUnknown, Mode=OneWay}" />
        </StackPanel>

        <!-- Files. -->
        <Grid Grid.Row="2">
            <ListView x:Name="FileList" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnFileClick"
                      ItemContainerStyle="{StaticResource CompareRowContainer}" x:Uid="CompareFileList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BranchCompareRow">
                        <StackPanel>
                            <TextBlock Text="{x:Bind GroupTitle}" Style="{StaticResource VigoLabelText}" Margin="14,12,0,4" Visibility="{x:Bind HasGroupTitle}" />
                            <Grid ColumnSpacing="10" Padding="14,0,12,0" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="24" Height="24" VerticalAlignment="Center">
                                    <Border CornerRadius="6" Background="{ThemeResource VigoAccentSoftBrush}" Visibility="{x:Bind IsOnlyOneSide}">
                                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoAccentTextBrush}" Glyph="{x:Bind controls:FluentIcons.FromName(Icon)}" />
                                    </Border>
                                    <Border CornerRadius="6" Background="{ThemeResource VigoSuccessSoftBrush}" Visibility="{x:Bind IsAhead}">
                                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoSuccessBrush}" Glyph="{x:Bind controls:FluentIcons.FromName(Icon)}" />
                                    </Border>
                                    <Border CornerRadius="6" Background="{ThemeResource VigoWarningSoftBrush}" Visibility="{x:Bind IsMergeable}">
                                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoWarningBrush}" Glyph="{x:Bind controls:FluentIcons.FromName(Icon)}" />
                                    </Border>
                                    <Border CornerRadius="6" Background="{ThemeResource VigoDangerSoftBrush}" Visibility="{x:Bind IsConflict}">
                                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoDangerBrush}" Glyph="{x:Bind controls:FluentIcons.FromName(Icon)}" />
                                    </Border>
                                    <Border CornerRadius="6" Background="{ThemeResource VigoLayerBrush}" Visibility="{x:Bind IsIdentical}">
                                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText3Brush}" Glyph="{x:Bind controls:FluentIcons.FromName(Icon)}" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource VigoStrongText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource VigoLabelText}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasDetail}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Style="{StaticResource VigoLabelText}" Margin="16,20" TextWrapping="Wrap" VerticalAlignment="Top"
                       Visibility="{x:Bind ViewModel.HasEmptyMessage, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource VigoDangerBrush}" Margin="16,20" TextWrapping="Wrap" VerticalAlignment="Top"
                       Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            <ProgressRing Width="24" Height="24" VerticalAlignment="Top" Margin="0,24,0,0" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
