<?xml version="1.0" encoding="utf-8"?>
<!--
    Pull request (J6.9a, read only), shown in place of the graph: header (title, state, branches, labels, totals), then the
    conversation (description, checks, comments, reviews, comments on the diff), the commits and the changed files with their
    diff in the code editor. Texts: x:Uid (ADR-075); the comment boxes reuse the "Issue*" uids of IssueView.
-->
<UserControl
    x:Class="Vigo.App.Controls.PullRequestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vigo.App.Controls"
    xmlns:vm="using:Vigo.Core.ViewModels"
    x:Uid="PrView">

    <UserControl.Resources>
        <Style x:Key="PullRequestRowContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="PullRequestTabButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="{ThemeResource VigoFontSize12}" />
        </Style>

        <!-- File row: badge, name (+ its folder in path mode), comment count, +/−; then the start of its discussions (click: opens the thread in the code). -->
        <DataTemplate x:Key="PullRequestFileTemplate" x:DataType="vm:PullRequestFileRow">
            <StackPanel Padding="0,6" Margin="{x:Bind controls:PullRequestView.IndentMargin(Indent), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Path}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:StatusBadge Letter="{x:Bind StatusLetter}" VerticalAlignment="Center" />
                    <!-- Same fixed line height (18) for every text and icon of the row: the fonts' own metrics would shift them. -->
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{ThemeResource VigoFontSize13}"
                               LineHeight="{ThemeResource VigoLineHeight18}" LineStackingStrategy="BlockLineHeight">
                        <Run Text="{x:Bind FileName}" />
                        <Run Text="{x:Bind DirectoryLabel, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" />
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Height="18" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="3" Height="18" Visibility="{x:Bind HasComments, Mode=OneWay}"
                                    x:Uid="PrFileComments">
                            <Grid Width="14" Height="18">
                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{ThemeResource VigoAccentTextBrush}" Glyph="{x:Bind controls:FluentIcons.Comment}" />
                            </Grid>
                            <TextBlock Text="{x:Bind CommentsText, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" LineHeight="{ThemeResource VigoLineHeight18}" LineStackingStrategy="BlockLineHeight"
                                       VerticalAlignment="Center" Foreground="{ThemeResource VigoAccentTextBrush}" />
                        </StackPanel>
                        <TextBlock FontFamily="{StaticResource VigoMonoFont}" FontSize="{ThemeResource VigoFontSize12}" LineHeight="{ThemeResource VigoLineHeight18}" LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center">
                            <Run Text="{x:Bind AdditionsText, Mode=OneWay}" Foreground="{ThemeResource VigoAddTextBrush}" />
                            <Run Text="{x:Bind DeletionsText, Mode=OneWay}" Foreground="{ThemeResource VigoDelTextBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{x:Bind Previews}" Visibility="{x:Bind HasPreviews, Mode=OneWay}" Margin="24,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileCommentPreview">
                            <Button Style="{StaticResource VigoSubtleButton}" Padding="6,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Click="OnPreviewClick" ToolTipService.ToolTip="{x:Bind Snippet}" AutomationProperties.Name="{x:Bind Snippet}">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" VerticalAlignment="Top" Height="16"
                                              Foreground="{ThemeResource VigoText3Brush}" Glyph="{x:Bind controls:FluentIcons.Comment}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Height="16">
                                            <TextBlock Text="{x:Bind Author}" FontSize="{ThemeResource VigoFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource VigoText2Brush}" />
                                            <TextBlock Text="{x:Bind LineText}" FontSize="{ThemeResource VigoFontSize11}" FontFamily="{StaticResource VigoMonoFont}" VerticalAlignment="Center" Foreground="{ThemeResource VigoText3Brush}" />
                                            <TextBlock Text="{x:Bind StatusText}" FontSize="{ThemeResource VigoFontSize11}" VerticalAlignment="Center" Foreground="{ThemeResource VigoSuccessBrush}" Visibility="{x:Bind IsResolved}" />
                                            <TextBlock Text="{x:Bind ReplyText}" FontSize="{ThemeResource VigoFontSize11}" VerticalAlignment="Center" Foreground="{ThemeResource VigoText3Brush}" Visibility="{x:Bind HasReplies}"
                                                       x:Uid="PrReplies" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Snippet}" FontSize="{ThemeResource VigoFontSize12}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource VigoText2Brush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Folder row of the tree: a click collapses or expands it. -->
        <DataTemplate x:Key="PullRequestFolderTemplate" x:DataType="vm:FolderRow">
            <Grid Height="30" Margin="{x:Bind controls:PullRequestView.IndentMargin(Indent), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Path}">
                <controls:FolderRowContent Folder="{x:Bind}" />
            </Grid>
        </DataTemplate>

        <controls:FileRowTemplateSelector x:Key="PullRequestFileSelector"
                                          FileTemplate="{StaticResource PullRequestFileTemplate}"
                                          FolderTemplate="{StaticResource PullRequestFolderTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged" Background="{ThemeResource VigoSunkenBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header. -->
        <Grid x:Name="Header" HorizontalAlignment="Left" Padding="8,8,14,0" RowSpacing="6" Background="{ThemeResource VigoLayerBrush}"
              BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Uid="PrBack" Style="{StaticResource VigoSubtleButton}" Height="28" Padding="6,0" Click="OnCloseClick">
                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText2Brush}"
                              Glyph="{x:Bind controls:FluentIcons.ChevronLeft}" />
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Glyph="{x:Bind controls:FluentIcons.BranchRequest}" />
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource VigoStrongText}" FontSize="{ThemeResource VigoFontSize15}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.NumberText, Mode=OneWay}" Foreground="{ThemeResource VigoText3Brush}" FontSize="{ThemeResource VigoFontSize15}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <Button x:Uid="PrRefresh" Style="{StaticResource VigoSubtleButton}" Height="28" Padding="8,0" Command="{x:Bind ViewModel.RefreshCommand}">
                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Glyph="{x:Bind controls:FluentIcons.ArrowSync}" />
                    </Button>
                    <Button x:Uid="PrMarkReady" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Command="{x:Bind ViewModel.MarkReadyCommand}"
                            Visibility="{x:Bind ViewModel.CanMarkReady, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <TextBlock x:Uid="PrMarkReadyText" FontSize="{ThemeResource VigoFontSize12}" />
                    </Button>
                    <Button x:Uid="PrMakeDraft" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Command="{x:Bind ViewModel.MakeDraftCommand}"
                            Visibility="{x:Bind ViewModel.CanMakeDraft, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <TextBlock x:Uid="PrMakeDraftText" FontSize="{ThemeResource VigoFontSize12}" />
                    </Button>
                    <Button x:Uid="PrUpdateBranch" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Command="{x:Bind ViewModel.UpdateBranchCommand}"
                            Visibility="{x:Bind ViewModel.CanUpdateBranch, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <TextBlock x:Uid="PrUpdateBranchText" FontSize="{ThemeResource VigoFontSize12}" />
                    </Button>
                    <Button x:Uid="PrDeleteBranch" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Command="{x:Bind ViewModel.DeleteSourceBranchCommand}"
                            Visibility="{x:Bind ViewModel.CanDeleteSourceBranch, Mode=OneWay}">
                        <TextBlock x:Uid="PrDeleteBranchText" FontSize="{ThemeResource VigoFontSize12}" />
                    </Button>
                    <Button x:Uid="PrClose" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Command="{x:Bind ViewModel.ClosePullRequestCommand}"
                            Visibility="{x:Bind ViewModel.CanClose, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <TextBlock x:Uid="PrCloseText" FontSize="{ThemeResource VigoFontSize12}" />
                    </Button>
                    <Button x:Uid="PrReopen" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Command="{x:Bind ViewModel.ReopenPullRequestCommand}"
                            Visibility="{x:Bind ViewModel.CanReopen, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <TextBlock x:Uid="IssueReopenText" FontSize="{ThemeResource VigoFontSize12}" />
                    </Button>
                    <Button x:Uid="PrAutoMerge" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0"
                            Visibility="{x:Bind ViewModel.CanEnableAutoMerge, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <TextBlock x:Uid="PrAutoMergeText" FontSize="{ThemeResource VigoFontSize12}" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="PrMergeCommit" Click="OnAutoMergeCommitClick" />
                                <MenuFlyoutItem x:Uid="PrMergeSquash" Click="OnAutoMergeSquashClick" />
                                <MenuFlyoutItem x:Uid="PrMergeRebase" Click="OnAutoMergeRebaseClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Uid="PrDisableAutoMerge" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Command="{x:Bind ViewModel.DisableAutoMergeCommand}"
                            Visibility="{x:Bind ViewModel.CanDisableAutoMerge, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.AutoMergeText, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" />
                    </Button>
                    <Button x:Uid="PrVote" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0"
                            Visibility="{x:Bind ViewModel.CanVote, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanCastVote, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.VoteToolTip, Mode=OneWay}">
                        <TextBlock x:Uid="PrVoteText" FontSize="{ThemeResource VigoFontSize12}" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="PrVoteApproved" Click="OnVoteApprovedClick" />
                                <MenuFlyoutItem x:Uid="PrVoteSuggestions" Click="OnVoteSuggestionsClick" />
                                <MenuFlyoutItem x:Uid="PrVoteWaiting" Click="OnVoteWaitingClick" />
                                <MenuFlyoutItem x:Uid="PrVoteRejected" Click="OnVoteRejectedClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="PrVoteNone" Click="OnVoteNoneClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="MergeButton" x:Uid="PrMerge" Style="{StaticResource VigoAccentButton}" Height="28" Padding="10,0"
                            Visibility="{x:Bind ViewModel.CanMerge, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Glyph="{x:Bind controls:FluentIcons.Merge}" />
                            <TextBlock x:Uid="PrMergeText" FontSize="{ThemeResource VigoFontSize12}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="PrMergeCommit" Click="OnMergeCommitClick" />
                                <MenuFlyoutItem x:Uid="PrMergeSquash" Click="OnMergeSquashClick" />
                                <MenuFlyoutItem x:Uid="PrMergeRebase" Click="OnMergeRebaseClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Uid="PrBrowser" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Command="{x:Bind ViewModel.OpenInBrowserCommand}">
                        <TextBlock x:Uid="IssueBrowserText" FontSize="{ThemeResource VigoFontSize12}" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="36,0,0,0">
                <Border x:Name="StateBadge" Height="20" Padding="8,0" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock x:Name="StateLabel" FontSize="{ThemeResource VigoFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.BranchText, Mode=OneWay}" FontFamily="{StaticResource VigoMonoFont}" FontSize="{ThemeResource VigoFontSize12}"
                           Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind ViewModel.Author, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.TotalsText, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Labels, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasLabels, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PullRequestLabelRow">
                            <Border Height="20" Padding="8,0" CornerRadius="10" Background="{ThemeResource VigoAccentSoftBrush}">
                                <TextBlock Text="{x:Bind Name}" FontSize="{ThemeResource VigoFontSize11}" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Row="2" Margin="30,0,24,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Uid="PrTabConversation" Style="{StaticResource PullRequestTabButton}" Click="OnConversationClick"
                              IsChecked="{x:Bind ViewModel.IsConversation, Mode=OneWay}">
                    <TextBlock x:Uid="PrTabConversationText" />
                </ToggleButton>
                <ToggleButton x:Uid="PrTabCommits" Style="{StaticResource PullRequestTabButton}" Click="OnCommitsClick"
                              IsChecked="{x:Bind ViewModel.IsCommits, Mode=OneWay}">
                    <TextBlock x:Uid="PrTabCommitsText" />
                </ToggleButton>
                <ToggleButton x:Uid="PrTabFiles" Style="{StaticResource PullRequestTabButton}" Click="OnFilesClick"
                              IsChecked="{x:Bind ViewModel.IsFiles, Mode=OneWay}">
                    <TextBlock x:Uid="PrTabFilesText" />
                </ToggleButton>
              </StackPanel>
                <controls:LayoutToggle Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{x:Bind ViewModel.ToggleLayoutCommand}"
                        Visibility="{x:Bind ViewModel.IsFiles, Mode=OneWay}" IsSideBySide="{x:Bind ViewModel.IsSideBySide, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- Content of the selected tab. -->
        <Grid x:Name="Pages" Grid.Row="1" HorizontalAlignment="Left">
            <TextBlock Margin="24,20" Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource VigoSecondaryText}"
                       IsHitTestVisible="False" />

            <!-- Conversation. -->
            <ScrollViewer x:Name="ConversationScroll" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.IsConversation, Mode=OneWay}" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ConversationColumn" Padding="24,16" Spacing="12" HorizontalAlignment="Left">
                    <InfoBar x:Uid="PrTruncated" IsOpen="{x:Bind ViewModel.IsTruncated, Mode=OneWay}" IsClosable="False" Severity="Informational" />

                    <Border Style="{StaticResource VigoCard}" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="IssueDescriptionTitle" Style="{StaticResource VigoStrongText}" />
                            <controls:MarkdownView Blocks="{x:Bind ViewModel.Description, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay}" />
                            <TextBlock x:Uid="IssueNoDescription" Style="{StaticResource VigoSecondaryText}" FontSize="{ThemeResource VigoFontSize12}"
                                       Visibility="{x:Bind controls:PullRequestView.Inverse(ViewModel.HasDescription), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource VigoCard}" Padding="14" Visibility="{x:Bind controls:PullRequestView.HasItems(ViewModel.Checks.Count), Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Glyph="{x:Bind controls:FluentIcons.CheckmarkCircle}"
                                              Foreground="{ThemeResource VigoSuccessBrush}" Visibility="{x:Bind ViewModel.ChecksPassed, Mode=OneWay}" />
                                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Glyph="{x:Bind controls:FluentIcons.ErrorCircle}"
                                              Foreground="{ThemeResource VigoDangerBrush}" Visibility="{x:Bind ViewModel.ChecksFailed, Mode=OneWay}" />
                                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Glyph="{x:Bind controls:FluentIcons.ArrowSync}"
                                              Foreground="{ThemeResource VigoWarningBrush}" Visibility="{x:Bind ViewModel.ChecksRunning, Mode=OneWay}" />
                                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Glyph="{x:Bind controls:FluentIcons.Circle}"
                                              Foreground="{ThemeResource VigoText3Brush}" Visibility="{x:Bind ViewModel.ChecksNeutral, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Grid.Column="1" x:Uid="PrChecksTitle" Style="{StaticResource VigoStrongText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ChecksSummary, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="3" Padding="6,1" CornerRadius="8" Background="{ThemeResource VigoDangerSoftBrush}" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.HasRequiredFailure, Mode=OneWay}">
                                    <TextBlock x:Uid="PrChecksRequiredFailed" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoDangerBrush}" />
                                </Border>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                                    <Button x:Uid="PrChecksRefresh" Style="{StaticResource VigoSubtleButton}" Height="24" Padding="6,0"
                                            Command="{x:Bind ViewModel.RefreshChecksCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanRefreshChecks, Mode=OneWay}">
                                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.ArrowSync}" />
                                    </Button>
                                    <Button x:Uid="PrChecksToggle" Style="{StaticResource VigoSubtleButton}" Height="24" Padding="6,0" Click="OnChecksToggleClick">
                                        <FontIcon x:Name="ChecksChevron" Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.ChevronDown}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ItemsControl x:Name="ChecksList" ItemsSource="{x:Bind ViewModel.Checks, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PullRequestCheckRow">
                                        <Grid ColumnSpacing="8" Padding="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid VerticalAlignment="Center">
                                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Glyph="{x:Bind controls:FluentIcons.CheckmarkCircle}"
                                                          Foreground="{ThemeResource VigoSuccessBrush}" Visibility="{x:Bind IsSuccess}" />
                                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Glyph="{x:Bind controls:FluentIcons.ErrorCircle}"
                                                          Foreground="{ThemeResource VigoDangerBrush}" Visibility="{x:Bind IsFailed}" />
                                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Glyph="{x:Bind controls:FluentIcons.ArrowSync}"
                                                          Foreground="{ThemeResource VigoWarningBrush}" Visibility="{x:Bind IsPending}" />
                                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Glyph="{x:Bind controls:FluentIcons.Circle}"
                                                          Foreground="{ThemeResource VigoText3Brush}" Visibility="{x:Bind IsSkipped}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontSize="{ThemeResource VigoFontSize12}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Description}" Visibility="{x:Bind HasDescription}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" Visibility="{x:Bind HasDuration}" FontSize="{ThemeResource VigoFontSize11}"
                                                       Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="3" Padding="6,1" CornerRadius="8" Background="{ThemeResource VigoAccentSoftBrush}" VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsRequired}">
                                                <TextBlock Text="{x:Bind RequiredText}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoAccentTextBrush}" />
                                            </Border>
                                            <Button Grid.Column="4" x:Uid="PrCheckOpen" Style="{StaticResource VigoSubtleButton}" Height="24" Padding="6,0"
                                                    Command="{x:Bind OpenCommand}" Visibility="{x:Bind HasUrl}">
                                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.Open}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Timeline, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimelineRow">
                                <Border Style="{StaticResource VigoCard}" Padding="14">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{x:Bind controls:LaneBrushes.For(AuthorColorIndex)}">
                                                <TextBlock Text="{x:Bind AuthorInitials}" Foreground="White" FontSize="{ThemeResource VigoFontSize8}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Author}" Style="{StaticResource VigoStrongText}" FontSize="{ThemeResource VigoFontSize12}" VerticalAlignment="Center" />
                                            <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Glyph="{x:Bind controls:FluentIcons.CheckmarkCircle}"
                                                      Foreground="{ThemeResource VigoSuccessBrush}" Visibility="{x:Bind IsApproved}" VerticalAlignment="Center" />
                                            <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Glyph="{x:Bind controls:FluentIcons.Dismiss}"
                                                      Foreground="{ThemeResource VigoDangerBrush}" Visibility="{x:Bind IsChangesRequested}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Action}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind DateText}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" Spacing="2" Visibility="{x:Bind CanModify}">
                                                <Button x:Uid="IssueEditComment" Style="{StaticResource VigoSubtleButton}" Height="24" Padding="6,0" Click="OnEditCommentClick">
                                                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.Edit}" />
                                                </Button>
                                                <Button x:Uid="IssueDeleteComment" Style="{StaticResource VigoSubtleButton}" Height="24" Padding="6,0" Click="OnDeleteCommentClick">
                                                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.Delete}" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Location}" Visibility="{x:Bind HasLocation}" FontFamily="{StaticResource VigoMonoFont}" FontSize="{ThemeResource VigoFontSize11}"
                                                   Foreground="{ThemeResource VigoText3Brush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                        <StackPanel Visibility="{x:Bind IsReading, Mode=OneWay}">
                                            <controls:MarkdownView Blocks="{x:Bind Body}" Visibility="{x:Bind HasBody}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind CanReact}">
                                            <ItemsControl ItemsSource="{x:Bind Reactions}" Visibility="{x:Bind HasReactions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReactionChip">
                                                        <Button Style="{StaticResource VigoStandardButton}" Height="24" Padding="8,0" Click="OnReactionClick"
                                                                ToolTipService.ToolTip="{x:Bind ToolTip}" AutomationProperties.Name="{x:Bind ToolTip}">
                                                            <TextBlock Text="{x:Bind Text}" FontSize="{ThemeResource VigoFontSize12}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button x:Uid="IssueAddReaction" Style="{StaticResource VigoSubtleButton}" Height="24" Padding="6,0" Click="OnAddReactionClick">
                                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.Add}" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Spacing="6" Visibility="{x:Bind IsEditing, Mode=OneWay}">
                                            <TextBox x:Uid="IssueCommentText" Text="{x:Bind EditText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button x:Uid="IssueSave" Style="{StaticResource VigoAccentButton}" Height="28" Padding="10,0" Click="OnSaveEditClick">
                                                    <TextBlock x:Uid="IssueSaveText" FontSize="{ThemeResource VigoFontSize12}" />
                                                </Button>
                                                <Button x:Uid="IssueCancelEdit" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Click="OnCancelEditClick">
                                                    <TextBlock x:Uid="IssueCancelEditText" FontSize="{ThemeResource VigoFontSize12}" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- New comment. -->
                    <Border Style="{StaticResource VigoCard}" Padding="14" Visibility="{x:Bind ViewModel.CanComment, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="IssueNewCommentTitle" Style="{StaticResource VigoStrongText}" />
                            <TextBox x:Uid="IssueNewComment" Text="{x:Bind ViewModel.CommentDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="90" />
                            <Button x:Uid="IssueComment" Style="{StaticResource VigoAccentButton}" Height="28" Padding="10,0" Command="{x:Bind ViewModel.AddCommentCommand}"
                                    HorizontalAlignment="Right">
                                <TextBlock x:Uid="IssueCommentButtonText" FontSize="{ThemeResource VigoFontSize12}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Commits. -->
            <ListView x:Uid="PrCommitList" Visibility="{x:Bind ViewModel.IsCommits, Mode=OneWay}" SelectionMode="None" Padding="0,6"
                      ItemsSource="{x:Bind ViewModel.Commits, Mode=OneWay}" ItemContainerStyle="{StaticResource PullRequestRowContainer}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PullRequestCommitRow">
                        <StackPanel Padding="0,8" Spacing="2">
                            <TextBlock Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis" FontSize="{ThemeResource VigoFontSize13}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="16" Height="16" CornerRadius="8" Background="{x:Bind controls:LaneBrushes.For(AuthorColorIndex)}">
                                    <TextBlock Text="{x:Bind AuthorInitials}" Foreground="White" FontSize="{ThemeResource VigoFontSize7}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Bind Meta}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Files and the diff of the selected one. -->
            <Grid x:Name="FilesPanel" HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.IsFiles, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilesColumn" Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource VigoLayerBrush}" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Height="32" Padding="12,0,8,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.TotalsText, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <controls:FileListModeSwitch x:Name="FilesModeSwitch" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <controls:FolderToggleBar Grid.Row="1" Rows="{x:Bind ViewModel.FileRows, Mode=OneWay}" ToggleRequested="OnToggleFolders" />
                        <ListView x:Name="FileList" x:Uid="PrFileList" Grid.Row="2" SelectionMode="Single" Padding="0,0,0,6" ItemsSource="{x:Bind ViewModel.FileRows, Mode=OneWay}"
                                  ItemTemplateSelector="{StaticResource PullRequestFileSelector}"
                                  ItemContainerStyle="{StaticResource PullRequestRowContainer}" SelectionChanged="OnFileSelectionChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" />
                    </Grid>
                </Border>
                <controls:Splitter x:Name="FilesSplitter" x:Uid="PrFilesSplitter" Grid.Column="1" HorizontalAlignment="Left" Margin="-3,0,0,0"
                                   Canvas.ZIndex="1" />
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <controls:CodeEditor x:Name="Editor" />
                        <TextBlock x:Name="DiffMessage" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Style="{StaticResource VigoSecondaryText}" />
                    </Grid>

                    <!-- Review (J6.9e): the review to send (decision and summary). The discussions and the comment boxes live in the diff (J6.11). -->
                    <Border Grid.Row="1" Background="{ThemeResource VigoLayerBrush}" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,1,0,0"
                            Visibility="{x:Bind ViewModel.ShowReviewPanel, Mode=OneWay}">
                        <Expander x:Name="ReviewExpander" x:Uid="PrReviewExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                                    <TextBlock x:Uid="PrReviewTitle" Style="{StaticResource VigoStrongText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.DraftsText, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoAccentTextBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                                <StackPanel Padding="12,8" Spacing="12">
                                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CanReview, Mode=OneWay}">
                                    <TextBlock x:Uid="PrFinishReview" Style="{StaticResource VigoStrongText}" FontSize="{ThemeResource VigoFontSize12}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Drafts, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ReviewDraftRow">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Location}" FontFamily="{StaticResource VigoMonoFont}" FontSize="{ThemeResource VigoFontSize11}"
                                                                   Foreground="{ThemeResource VigoText3Brush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Text}" FontSize="{ThemeResource VigoFontSize12}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button x:Uid="PrRemoveDraft" Grid.Column="1" Style="{StaticResource VigoSubtleButton}" Height="24" Padding="6,0" Click="OnRemoveDraftClick">
                                                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.Delete}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBox x:Uid="PrReviewText" Text="{x:Bind ViewModel.ReviewText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="56" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.CanSubmitReview, Mode=OneWay}">
                                        <Button x:Uid="PrReviewComment" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Click="OnReviewCommentClick">
                                            <TextBlock x:Uid="IssueCommentButtonText" FontSize="{ThemeResource VigoFontSize12}" />
                                        </Button>
                                        <Button x:Uid="PrReviewApprove" Style="{StaticResource VigoAccentButton}" Height="28" Padding="10,0" Click="OnReviewApproveClick">
                                            <TextBlock x:Uid="PrReviewApproveText" FontSize="{ThemeResource VigoFontSize12}" />
                                        </Button>
                                        <Button x:Uid="PrReviewChanges" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Click="OnReviewRequestChangesClick">
                                            <TextBlock x:Uid="PrReviewChangesText" FontSize="{ThemeResource VigoFontSize12}" />
                                        </Button>
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
