<?xml version="1.0" encoding="utf-8"?>
<!--
    Interactive rebase (J5.5, mockup VIGO Outils.dc.html, "Rebase" screen), shown in place of the graph: the commits to
    replay, oldest first, each with its action (pick, reword, edit, squash, fixup, drop; keys P R E S F D), reordered with
    Alt+↑ / Alt+↓ or drag and drop; on the right, the result card and "Démarrer le rebase".
    Action colors: lanes 1, 5, 6, 7, 9 and danger, as in the mockup (one dot per action, shown by its index).
-->
<UserControl
    x:Class="Vigo.App.Controls.RebaseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vigo.App.Controls"
    xmlns:vm="using:Vigo.Core.ViewModels"
    x:Uid="RebaseRoot">

    <UserControl.Resources>
        <Style x:Key="RebaseRowContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Legend chip: dot, action, key. -->
        <Style x:Key="LegendChip" TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource VigoStrokeSubtleBrush}" />
        </Style>
        <Style x:Key="LegendKey" TargetType="Border">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource VigoStrokeBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource VigoSunkenBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: back to the graph, title, branch and upstream. -->
        <Grid Padding="8,0,12,0" ColumnSpacing="10" Background="{ThemeResource VigoLayerBrush}"
              BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="RebaseBackButton" Style="{StaticResource VigoSubtleButton}" Height="28" Padding="8,0" Click="OnCloseClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText2Brush}"
                              Glyph="{x:Bind controls:FluentIcons.ChevronLeft}" />
                    <TextBlock x:Uid="RebaseBackText" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" />
                </StackPanel>
            </Button>
            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="6" Background="{ThemeResource VigoAccentSoftBrush}">
                <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Foreground="{ThemeResource VigoAccentTextBrush}"
                          Glyph="{x:Bind controls:FluentIcons.ReOrderDotsVertical}" />
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Uid="RebaseTitle" Style="{StaticResource VigoStrongText}" />
                <TextBlock FontSize="{ThemeResource VigoFontSize11}" LineHeight="{ThemeResource VigoLineHeight14}" Foreground="{ThemeResource VigoText3Brush}" TextTrimming="CharacterEllipsis">
                    <Run Text="{x:Bind ViewModel.BranchName, Mode=OneWay}" Foreground="{ThemeResource VigoLane5Brush}" FontWeight="SemiBold" />
                    <Run x:Uid="RebaseOnRun" />
                    <Run Text="{x:Bind ViewModel.UpstreamName, Mode=OneWay}" Foreground="{ThemeResource VigoLane1Brush}" FontWeight="SemiBold" />
                    <Run Text=" " />
                    <Run Text="{x:Bind ViewModel.UpstreamSha, Mode=OneWay}" FontFamily="{StaticResource VigoMonoFont}" />
                    <Run Text=" · " />
                    <Run Text="{x:Bind ViewModel.Details, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1180" Padding="32,24" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="14">
                    <!-- Legend: actions and their keys. -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource LegendChip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource VigoLane1Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="pick" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="P" FontSize="{ThemeResource VigoFontSize11}" FontFamily="{StaticResource VigoMonoFont}" Foreground="{ThemeResource VigoText3Brush}" /></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource LegendChip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource VigoLane5Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="reword" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="R" FontSize="{ThemeResource VigoFontSize11}" FontFamily="{StaticResource VigoMonoFont}" Foreground="{ThemeResource VigoText3Brush}" /></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource LegendChip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource VigoLane6Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="edit" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="E" FontSize="{ThemeResource VigoFontSize11}" FontFamily="{StaticResource VigoMonoFont}" Foreground="{ThemeResource VigoText3Brush}" /></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource LegendChip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource VigoLane7Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="squash" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="S" FontSize="{ThemeResource VigoFontSize11}" FontFamily="{StaticResource VigoMonoFont}" Foreground="{ThemeResource VigoText3Brush}" /></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource LegendChip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource VigoLane9Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="fixup" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="F" FontSize="{ThemeResource VigoFontSize11}" FontFamily="{StaticResource VigoMonoFont}" Foreground="{ThemeResource VigoText3Brush}" /></Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource LegendChip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource VigoDangerBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="drop" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource LegendKey}"><TextBlock Text="D" FontSize="{ThemeResource VigoFontSize11}" FontFamily="{StaticResource VigoMonoFont}" Foreground="{ThemeResource VigoText3Brush}" /></Border>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Uid="RebaseMoveHint" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}"
                                   VerticalAlignment="Center" Margin="4,0" />
                    </StackPanel>

                    <!-- Commits, oldest first. -->
                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" Background="{ThemeResource VigoCardBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Padding="4,0,10,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="RebaseColAction" Grid.Column="1" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="SHA" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="RebaseColMessage" Grid.Column="3" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock x:Uid="RebaseColAuthor" Grid.Column="4" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="Date" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                            </Grid>
                            <ListView x:Name="RowList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Single"
                                      SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=OneWay}" SelectionChanged="OnSelectionChanged"
                                      CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                                      ItemContainerStyle="{StaticResource RebaseRowContainer}"
                                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      PreviewKeyDown="OnRowsPreviewKeyDown" x:Uid="RebaseList">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RebaseRow">
                                        <Grid Padding="4,0,10,0" MinHeight="40" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Foreground="{ThemeResource VigoText3Brush}"
                                                      Glyph="{x:Bind controls:FluentIcons.ReOrderDotsVertical}" x:Uid="RebaseDragHandle" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Grid Width="8" Height="8" VerticalAlignment="Center">
                                                    <Ellipse Fill="{ThemeResource VigoLane1Brush}" Visibility="{x:Bind controls:RebaseView.Shows(ActionIndex, 0), Mode=OneWay}" />
                                                    <Ellipse Fill="{ThemeResource VigoLane5Brush}" Visibility="{x:Bind controls:RebaseView.Shows(ActionIndex, 1), Mode=OneWay}" />
                                                    <Ellipse Fill="{ThemeResource VigoLane6Brush}" Visibility="{x:Bind controls:RebaseView.Shows(ActionIndex, 2), Mode=OneWay}" />
                                                    <Ellipse Fill="{ThemeResource VigoLane7Brush}" Visibility="{x:Bind controls:RebaseView.Shows(ActionIndex, 3), Mode=OneWay}" />
                                                    <Ellipse Fill="{ThemeResource VigoLane9Brush}" Visibility="{x:Bind controls:RebaseView.Shows(ActionIndex, 4), Mode=OneWay}" />
                                                    <Ellipse Fill="{ThemeResource VigoDangerBrush}" Visibility="{x:Bind controls:RebaseView.Shows(ActionIndex, 5), Mode=OneWay}" />
                                                </Grid>
                                                <ComboBox Width="104" Height="28" MinHeight="0" Padding="8,0" FontSize="{ThemeResource VigoFontSize12}" FontFamily="{StaticResource VigoMonoFont}"
                                                          SelectedIndex="{x:Bind ActionIndex, Mode=TwoWay}" AutomationProperties.Name="Action">
                                                    <x:String>pick</x:String>
                                                    <x:String>reword</x:String>
                                                    <x:String>edit</x:String>
                                                    <x:String>squash</x:String>
                                                    <x:String>fixup</x:String>
                                                    <x:String>drop</x:String>
                                                </ComboBox>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ShortSha}" FontSize="{ThemeResource VigoFontSize12}" FontFamily="{StaticResource VigoMonoFont}"
                                                       Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center"
                                                       TextDecorations="{x:Bind controls:RebaseView.Strike(IsDropped), Mode=OneWay}" />
                                            <Grid Grid.Column="3" Padding="{x:Bind controls:RebaseView.Indent(IsMelded), Mode=OneWay}" ColumnSpacing="6" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText3Brush}"
                                                          Glyph="{x:Bind controls:FluentIcons.ArrowTurnDownRight}" Visibility="{x:Bind IsMelded, Mode=OneWay}" />
                                                <TextBox Grid.Column="1" Text="{x:Bind Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" MinHeight="0"
                                                         Padding="8,4" FontSize="{ThemeResource VigoFontSize13}" Visibility="{x:Bind IsReword, Mode=OneWay}" AutomationProperties.Name="Nouveau message" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Commit.Subject}" FontSize="{ThemeResource VigoFontSize13}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Visibility="{x:Bind IsNotReword, Mode=OneWay}"
                                                           Opacity="{x:Bind controls:RebaseView.Dim(IsMelded, IsDropped), Mode=OneWay}"
                                                           TextDecorations="{x:Bind controls:RebaseView.Strike(IsDropped), Mode=OneWay}"
                                                           ToolTipService.ToolTip="{x:Bind Commit.Message}" />
                                                <Border Grid.Column="2" Height="18" Padding="6,0" CornerRadius="4" Background="{ThemeResource VigoLayer2Brush}"
                                                        Visibility="{x:Bind HasTag, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Tag, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText2Brush}" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="10" Background="{ThemeResource VigoLane5Brush}">
                                                    <TextBlock Text="{x:Bind AuthorInitials}" FontSize="{ThemeResource VigoFontSize9}" FontWeight="SemiBold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{x:Bind AuthorName}" FontSize="{ThemeResource VigoFontSize12}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="120" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="5" Text="{x:Bind DateText}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <TextBlock x:Uid="RebaseOrderHint" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText3Brush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Result card. -->
                <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Top">
                    <Border Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" Background="{ThemeResource VigoCardBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="RebaseResultTitle" Style="{StaticResource VigoCardTitleText}" />
                            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Result}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RebaseResultItem">
                                        <Grid Padding="0,6" ColumnSpacing="8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="10" Height="10" Margin="0,4,0,0" VerticalAlignment="Top">
                                                <Ellipse Stroke="{ThemeResource VigoLane5Brush}" StrokeThickness="2" Fill="{ThemeResource VigoLayerBrush}" />
                                                <Ellipse Stroke="{ThemeResource VigoLane5Brush}" StrokeThickness="2" Fill="{ThemeResource VigoWarningBrush}"
                                                         Visibility="{x:Bind IsPaused}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Message}" FontSize="{ThemeResource VigoFontSize12}" LineHeight="{ThemeResource VigoLineHeight18}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="{ThemeResource VigoFontSize12}" LineHeight="{ThemeResource VigoLineHeight18}" Foreground="{ThemeResource VigoText3Brush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Padding="10,8" CornerRadius="4" Background="{ThemeResource VigoDangerSoftBrush}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Foreground="{ThemeResource VigoDangerBrush}"
                                              Glyph="{x:Bind controls:FluentIcons.ErrorCircle}" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Error, Mode=OneWay}" FontSize="{ThemeResource VigoFontSize12}" LineHeight="{ThemeResource VigoLineHeight16}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Uid="RebaseResetButton" Style="{StaticResource VigoStandardButton}" Height="32" HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.ResetCommand}">
                                    <TextBlock x:Uid="RebaseResetText" FontSize="{ThemeResource VigoFontSize13}" />
                                </Button>
                                <Button x:Uid="RebaseStartButton" Grid.Column="1" Style="{StaticResource VigoAccentButton}" Height="32" HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.StartCommand}">
                                    <TextBlock x:Uid="RebaseStartText" FontSize="{ThemeResource VigoFontSize13}" FontWeight="SemiBold" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Padding="12,10" CornerRadius="8" Background="{ThemeResource VigoLayer2Brush}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Foreground="{ThemeResource VigoAccentTextBrush}"
                                      Glyph="{x:Bind controls:FluentIcons.Info}" VerticalAlignment="Top" />
                            <TextBlock x:Uid="RebaseUndoHint" Grid.Column="1" FontSize="{ThemeResource VigoFontSize12}" LineHeight="{ThemeResource VigoLineHeight16}" Foreground="{ThemeResource VigoText2Brush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
