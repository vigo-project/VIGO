<?xml version="1.0" encoding="utf-8"?>
<!--
    File history (J5.6, mockup VIGO Outils.dc.html, "Historique" screen), shown in place of the graph: the commits that
    changed the file (renames followed) on the left, the diff of the selected one in the code editor, "Blame à ce commit"
    and "Restaurer cette version". Two selected commits compare the file's versions; unified or side-by-side layout.
-->
<UserControl
    x:Class="Vigo.App.Controls.FileHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vigo.App.Controls"
    xmlns:vm="using:Vigo.Core.ViewModels"
    x:Uid="FhRoot">

    <UserControl.Resources>
        <Style x:Key="HistoryRowContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="6,0,10,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource VigoSunkenBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Commits of the file, newest first. -->
        <Grid Background="{ThemeResource VigoLayerBrush}" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Padding="8,8,14,10" Spacing="2" BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Uid="FhBackButton" Style="{StaticResource VigoSubtleButton}" Height="28" Padding="6,0" Click="OnCloseClick">
                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="14" Foreground="{ThemeResource VigoText2Brush}"
                                  Glyph="{x:Bind controls:FluentIcons.ChevronLeft}" />
                    </Button>
                    <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Glyph="{x:Bind controls:FluentIcons.History}" />
                    <TextBlock x:Uid="FhTitle" Style="{StaticResource VigoStrongText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Margin="6,0,0,0" Text="{x:Bind ViewModel.Path, Mode=OneWay}" FontFamily="{StaticResource VigoMonoFont}" FontSize="{ThemeResource VigoFontSize12}"
                           Foreground="{ThemeResource VigoText3Brush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                <CheckBox x:Uid="FhFollow" Margin="6,4,0,0" MinHeight="28" VerticalContentAlignment="Center" IsChecked="{x:Bind ViewModel.Follow, Mode=TwoWay}">
                    <TextBlock x:Uid="FhFollowText" FontSize="{ThemeResource VigoFontSize12}" Foreground="{ThemeResource VigoText2Brush}" />
                </CheckBox>
                <TextBlock x:Uid="FhCompareHint" Margin="6,2,0,0" FontSize="{ThemeResource VigoFontSize11}"
                           Foreground="{ThemeResource VigoText3Brush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Extended selection: two commits (Ctrl+click, Maj+click) compare the file's versions in them. -->
            <ListView x:Name="HistoryList" Grid.Row="1" Padding="0,6" SelectionMode="Extended"
                      ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}" ItemContainerStyle="{StaticResource HistoryRowContainer}"
                      SelectionChanged="OnSelectionChanged" x:Uid="FhList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileHistoryRow">
                        <Grid Padding="0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Timeline of the mockup: vertical line and a ring per commit. -->
                            <Border Width="2" Margin="0,-8" HorizontalAlignment="Center" Background="{ThemeResource VigoLane5Brush}" Opacity="0.5" />
                            <Ellipse Width="10" Height="10" Margin="0,4,0,0" VerticalAlignment="Top" StrokeThickness="2"
                                     Stroke="{ThemeResource VigoLane5Brush}" Fill="{ThemeResource VigoLayerBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis" FontSize="{ThemeResource VigoFontSize13}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="16" Height="16" CornerRadius="8" Background="{x:Bind controls:LaneBrushes.For(AuthorColorIndex)}">
                                        <TextBlock Text="{x:Bind AuthorInitials}" Foreground="White" FontSize="{ThemeResource VigoFontSize7}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Meta}" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText3Brush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Border HorizontalAlignment="Left" Height="18" Padding="6,0" CornerRadius="4" Background="{ThemeResource VigoWarningSoftBrush}"
                                        Visibility="{x:Bind HasNote}">
                                    <TextBlock Text="{x:Bind Note}" FontSize="{ThemeResource VigoFontSize11}" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock FontFamily="{StaticResource VigoMonoFont}" FontSize="{ThemeResource VigoFontSize11}">
                                    <Run Text="{x:Bind AdditionsText}" Foreground="{ThemeResource VigoAddTextBrush}" />
                                    <Run Text="{x:Bind DeletionsText}" Foreground="{ThemeResource VigoDelTextBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- Over the list: never hit-testable, or the rows only take clicks left of the empty message (timeline). -->
            <ProgressRing Grid.Row="1" Width="24" Height="24" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock Grid.Row="1" Margin="16,20" Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap"
                       Style="{StaticResource VigoSecondaryText}" IsHitTestVisible="False" />
        </Grid>

        <!-- Diff of the selected commit. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="14,0,12,0" ColumnSpacing="10" Background="{ThemeResource VigoLayerBrush}"
                  BorderBrush="{ThemeResource VigoStrokeSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SelectedShortSha, Mode=OneWay}" FontFamily="{StaticResource VigoMonoFont}" FontSize="{ThemeResource VigoFontSize12}"
                           Foreground="{ThemeResource VigoText3Brush}" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedSubject, Mode=OneWay}" Style="{StaticResource VigoStrongText}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Uid="FhBlameButton" Style="{StaticResource VigoSubtleButton}" Height="28" Padding="8,0" Command="{x:Bind ViewModel.BlameCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Style="{StaticResource VigoIcon}" FontSize="16" Glyph="{x:Bind controls:FluentIcons.Person}" />
                            <TextBlock x:Uid="FhBlameText" FontSize="{ThemeResource VigoFontSize12}" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="FhRestoreButton" Style="{StaticResource VigoStandardButton}" Height="28" Padding="10,0" Command="{x:Bind ViewModel.RestoreCommand}">
                        <TextBlock x:Uid="FhRestoreText" FontSize="{ThemeResource VigoFontSize12}" />
                    </Button>
                    <!-- Layout, shared with the diff view (Ctrl+Maj+M). -->
                    <controls:LayoutToggle VerticalAlignment="Center" Command="{x:Bind ViewModel.ToggleLayoutCommand}" IsSideBySide="{x:Bind ViewModel.IsSideBySide, Mode=OneWay}" />
                </StackPanel>
            </Grid>
            <controls:CodeEditor x:Name="Editor" Grid.Row="1" />
            <ProgressRing Grid.Row="1" Width="24" Height="24" IsActive="{x:Bind ViewModel.IsDiffLoading, Mode=OneWay}" />
            <TextBlock x:Name="DiffMessage" Grid.Row="1" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Style="{StaticResource VigoSecondaryText}" />
        </Grid>
    </Grid>
</UserControl>
