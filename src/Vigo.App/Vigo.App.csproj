<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Vigo.App</RootNamespace>
    <AssemblyName>Vigo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Vigo.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Build from the solution or without a platform: x64 by default (Win2D and the self-contained SDK require an architecture). -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == 'AnyCPU' or '$(Platform)' == '')">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != 'AnyCPU'">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Development: unpackaged, self-contained Windows App SDK (ADR-004). MSIX through a publish profile. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Source language of the texts (Strings\fr-FR); Strings\en-US is the translation (ADR-075). -->
    <DefaultLanguage>fr-FR</DefaultLanguage>
    <AppxDefaultResourceQualifiers>Language=fr-FR;en-US</AppxDefaultResourceQualifiers>
    <!-- Custom entry point (Program.cs): startup measurement, AOT probe. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <IsAotCompatible>true</IsAotCompatible>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <!-- .NET 11 RC2 publishes AOT without a full build (PrepareResources before references are resolved): the XAML compiler
         then finds no WinUI metadata (WMC1007 / WMC9999). Keep the full build until the Windows App SDK supports it. -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <!-- Trimming warnings from third-party dependencies are tracked in docs/DECISIONS.md (ADR-007). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="LoomTerminal.WinUI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vigo.Core\Vigo.Core.csproj" />
    <ProjectReference Include="..\Vigo.Git\Vigo.Git.csproj" />
    <ProjectReference Include="..\Vigo.Graph\Vigo.Graph.csproj" />
    <ProjectReference Include="..\Vigo.Integrations\Vigo.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Code editor page (Monaco), generated by tools/editor/build.mjs (ADR-038). -->
    <Content Include="Editor\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
