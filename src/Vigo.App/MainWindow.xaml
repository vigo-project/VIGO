<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vigo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vigo.App"
    xmlns:controls="using:Vigo.App.Controls"
    xmlns:services="using:Vigo.App.Services"
    xmlns:views="using:Vigo.App.Views"
    xmlns:vm="using:Vigo.Core.ViewModels"
    Title="VIGO">

    <!-- Accelerators are named in the tooltips of their commands, not shown over the whole window. -->
    <Grid x:Name="Root" Background="{ThemeResource VigoMicaAltBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <!-- Keyboard shortcuts: MainWindow.xaml.cs (KeyboardShortcuts, also reached from the code editor). -->

        <!-- Title bar: logo, repository tabs, drag area, caption buttons (drawn by Windows) -->
        <TabView
            x:Name="Tabs"
            Grid.Row="0"
            VerticalAlignment="Bottom"
            Background="Transparent"
            TabWidthMode="Equal"
            CanReorderTabs="True"
            CanDragTabs="True"
            AllowDropTabs="True"
            IsAddTabButtonVisible="True"
            TabItemsSource="{x:Bind ViewModel.Tabs}"
            AddTabButtonClick="OnAddTabButtonClick"
            Loaded="OnTabsLoaded"
            TabCloseRequested="OnTabCloseRequested"
            TabDragStarting="OnTabDragStarting"
            TabDragCompleted="OnTabDragCompleted"
            TabStripDragOver="OnTabStripDragOver"
            TabStripDrop="OnTabStripDrop"
            TabDroppedOutside="OnTabDroppedOutside"
            SelectionChanged="OnTabSelectionChanged">
            <TabView.Resources>
                <ResourceDictionary>
                    <x:Double x:Key="TabViewItemMaxWidth">200</x:Double>
                    <x:Double x:Key="TabViewItemMinWidth">120</x:Double>
                    <!-- Per theme (WinUI pattern): a plain StaticResource alias would keep the theme of the first load when
                         the theme preference changes (J4.6). -->
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="VigoLayerBrush" />
                            <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="VigoSubHoverBrush" />
                            <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="VigoText2Brush" />
                            <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="VigoTextBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="VigoLayerBrush" />
                            <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="VigoSubHoverBrush" />
                            <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="VigoText2Brush" />
                            <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="VigoTextBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </TabView.Resources>
            <TabView.TabStripHeader>
                <Grid Width="40" Height="32">
                    <Image
                        Width="20" Height="20"
                        Source="ms-appx:///Assets/Vigo.png"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="DragRegion" MinWidth="188" Background="Transparent" />
            </TabView.TabStripFooter>
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:TabViewModel">
                    <TabViewItem
                        Header="{x:Bind Title, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind local:MainWindow.TabTooltip(Title, ProjectName), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind local:MainWindow.TabTooltip(Title, ProjectName), Mode=OneWay}"
                        Loaded="OnTabItemLoaded"
                        DataContextChanged="OnTabItemDataContextChanged"
                        IconSource="{x:Bind local:MainWindow.TabIcon(IconName), Mode=OneWay}">
                        <!-- Items built by OnTabContextMenuOpening (project submenu depends on the tab and the projects). -->
                        <TabViewItem.ContextFlyout>
                            <MenuFlyout Opening="OnTabContextMenuOpening" />
                        </TabViewItem.ContextFlyout>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Active tab content (views cached per tab) -->
        <Grid
            x:Name="ContentHost"
            Grid.Row="1"
            Background="{ThemeResource VigoLayerBrush}"
            BorderBrush="{ThemeResource VigoStrokeSubtleBrush}"
            BorderThickness="0,1,0,0" />
        <!-- Frame in the color of the project of the selected tab (J7.6); drawn over the content, never hit. -->
        <!-- Sides and bottom only: its top line is drawn with the selected tab's outline (TabEdges, after it, so on top). -->
        <Grid x:Name="ProjectFrame" Grid.Row="1" IsHitTestVisible="False" SizeChanged="OnProjectFrameSizeChanged">
            <Border x:Name="ProjectFrameSides" BorderThickness="0" />
        </Grid>
        <!-- Colored edges of the tabs of a project (J7.6), placed by MainWindow.UpdateTabEdges; they overflow the title bar row. -->
        <Canvas x:Name="TabEdges" Grid.Row="0" IsHitTestVisible="False" />

        <!--
            Status bar (mockup): state of the selected repository tab on the left, application settings on the right.
        -->
        <Grid
            Grid.Row="2"
            Padding="6,0"
            ColumnSpacing="14"
            Background="{ThemeResource VigoMicaBrush}"
            BorderBrush="{ThemeResource VigoStrokeSubtleBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.StatusBar.IsRepository, Mode=OneWay}">
                <Button x:Uid="StatusBranchButton" Style="{StaticResource VigoStatusBarButton}" Click="OnStatusBranchClick"
                        AutomationProperties.Name="{x:Bind ViewModel.StatusBar.BranchText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.Branch}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusBar.BranchText, Mode=OneWay}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource VigoStatusBarButton}" Click="OnStatusSyncClick"
                        Content="{x:Bind ViewModel.StatusBar.SyncText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StatusBar.SyncTooltip, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText2Brush}" TextTrimming="CharacterEllipsis"
                           Text="{x:Bind ViewModel.StatusBar.InfoText, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.StatusBar.IsOperationRunning, Mode=OneWay}">
                    <ProgressRing Width="12" Height="12" MinWidth="12" MinHeight="12" IsActive="{x:Bind ViewModel.StatusBar.IsOperationRunning, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoTextBrush}"
                               Text="{x:Bind ViewModel.StatusBar.OperationText, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Uid="StatusProfileButton" Style="{StaticResource VigoStatusBarButton}" Click="OnStatusProfileClick"
                        AutomationProperties.Name="{x:Bind ViewModel.StatusBar.ProfileText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.FromName(ViewModel.StatusBar.ProfileIcon), Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.StatusBar.HasProfileIcon, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusBar.ProfileText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button x:Uid="StatusDensityButton" Style="{StaticResource VigoStatusBarButton}" Command="{x:Bind ViewModel.ToggleDensityCommand}"
                        Content="{x:Bind ViewModel.StatusBar.DensityLabel, Mode=OneWay}" />
                <Button x:Uid="StatusThemeButton" Style="{StaticResource VigoStatusBarButton}" Command="{x:Bind ViewModel.ToggleThemeCommand}"
                        AutomationProperties.Name="{x:Bind ViewModel.StatusBar.ThemeLabel, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.DarkTheme}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusBar.ThemeLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button x:Uid="StatusPaletteButton" Style="{StaticResource VigoStatusBarButton}" Click="OnStatusPaletteClick" />
                <TextBlock Margin="8,0,2,0" VerticalAlignment="Center" FontSize="{ThemeResource VigoFontSize11}" Foreground="{ThemeResource VigoText2Brush}"
                           Text="{x:Bind vm:StatusBarViewModel.VersionText}" ToolTipService.ToolTip="Visual Git Overview" />
                <!-- Update downloaded: restart to install it (green) -->
                <Button Style="{StaticResource VigoStatusBarButton}" Command="{x:Bind ViewModel.StatusBar.RestartToUpdateCommand}"
                        Visibility="{x:Bind ViewModel.StatusBar.IsUpdateReady, Mode=OneWay}"
                        Foreground="{ThemeResource VigoSuccessBrush}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StatusBar.UpdateTooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.StatusBar.UpdateTooltip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Style="{StaticResource VigoIcon}" FontSize="12" Glyph="{x:Bind controls:FluentIcons.ArrowSync}" />
                        <TextBlock x:Uid="StatusRestartText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Toasts -->
        <ItemsControl
            Grid.Row="1"
            Width="380"
            Margin="0,0,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            ItemsSource="{x:Bind Notifier.Items}">
            <ItemsControl.ItemTemplate>
                <!--
                    Countdown bar along the bottom edge of a toast that closes by itself: it shrinks to the left over
                    Notification.Lifetime and closes the toast when empty; paused while the pointer is over the toast.
                    The grid clips it to the rounded corners of the InfoBar.
                -->
                <DataTemplate x:DataType="services:Notification">
                    <Grid Margin="0,8,0,0" CornerRadius="{StaticResource ControlCornerRadius}"
                          PointerEntered="OnNotificationPointerEntered" PointerExited="OnNotificationPointerExited">
                        <InfoBar
                            IsOpen="True"
                            Severity="{x:Bind Severity}"
                            Title="{x:Bind Title}"
                            Message="{x:Bind Message}"
                            Background="{ThemeResource VigoFlyoutBrush}"
                            CloseButtonClick="OnNotificationClosed" />
                        <Rectangle Height="2" Margin="1,0,1,1" VerticalAlignment="Bottom" Fill="{ThemeResource VigoAccentBrush}"
                                   Visibility="{x:Bind AutoCloses}" Loaded="OnNotificationCountdownLoaded" Unloaded="OnNotificationCountdownUnloaded"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Command palette (Ctrl+P), over the whole window but the title bar -->
        <views:CommandPalette x:Name="Palette" Grid.Row="1" />
    </Grid>
</Window>
