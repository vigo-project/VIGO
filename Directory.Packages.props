<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MicrosoftExtensionsVersion>11.0.0-rc.3.26522.148</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Integrated terminal (native control, VT engine and ConPTY; brings LoomTerminal.Presentation, .Core and .Pty) -->
    <PackageVersion Include="LoomTerminal.WinUI" Version="0.1.0-alpha.2" />
    <!-- Code editor (native control ported from Monaco, Win2D; brings LoomEditor.Rendering, .View, .TextMate, .Themes and .Core) -->
    <PackageVersion Include="LoomEditor.WinUI" Version="0.2.0-alpha.2" />
    <!-- Markdown of pull requests and issues (parser only; rendered by the app) -->
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <!-- Hosting / logs -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Installer and auto-update (beta deployment); the vpk tool of the release workflow uses the same version -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <!-- Git -->
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
